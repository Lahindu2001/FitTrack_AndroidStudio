    <!-- Cardio Tip Descriptions -->
    <string name="cardio_tip_1_desc">Begin with walking, swimming, or cycling. These activities are easier on joints while building cardiovascular endurance.</string>
    <string name="cardio_tip_2_desc">Aim for 50 to 85% of your maximum heart rate. Calculate it as 220 minus your age for maximum heart rate.</string>
    <string name="cardio_tip_3_desc">Vary your cardio routine with running, dancing, rowing, or elliptical training to prevent boredom and work different muscle groups.</string>
    <string name="cardio_tip_4_desc">Alternate between high-intensity bursts and recovery periods. This improves cardiovascular fitness and burns more calories.</string>
    <string name="cardio_tip_5_desc">If you feel dizzy, short of breath, or experience chest pain, stop exercising immediately and consult a healthcare professional.</string>

