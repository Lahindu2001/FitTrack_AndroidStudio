    <!-- New strings for Nutrition Tips Screen -->
    <string name="nutrition_tips_title">Nutrition Tips</string>
    <string name="back_to_tips_desc">Back to Tips</string>
    <string name="tip_eat_balanced_meals_title">Eat Balanced Meals</string>
    <string name="tip_eat_balanced_meals_desc">Include protein, healthy fats, and complex carbohydrates in each meal. This provides sustained energy and supports muscle recovery.</string>
    <string name="tip_stay_hydrated_title">Stay Hydrated</string>
    <string name="tip_stay_hydrated_desc">Drink at least 8 glasses of water daily. Increase intake during workouts and hot weather to maintain optimal hydration.</string>
    <string name="tip_pre_workout_fuel_title">Pre-Workout Fuel</string>
    <string name="tip_pre_workout_fuel_desc">Eat a light snack with carbs and protein 30 to 60 minutes before exercise. Bananas, oatmeal, or yogurt are excellent choices.</string>
    <string name="tip_post_workout_recovery_title">Post-Workout Recovery</string>
    <string name="tip_post_workout_recovery_desc">Consume protein and carbs within 30 minutes after exercise to optimize muscle recovery and replenish energy stores.</string>
    <string name="tip_control_portion_sizes_title">Control Portion Sizes</string>
    <string name="tip_control_portion_sizes_desc">Use smaller plates and listen to hunger cues. Eat slowly to allow your brain to register fullness and prevent overeating.</string>
    <string name="tip_choose_whole_foods_title">Choose Whole Foods</string>
    <string name="tip_choose_whole_foods_desc">Prioritize fresh fruits, vegetables, lean proteins, and whole grains over processed foods. They provide more nutrients and fewer empty calories.</string>

