<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitTrack"
        tools:targetApi="31">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FitTrack.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Activity -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.FitTrack.NoActionBar" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.FitTrack.NoActionBar" />

        <!-- Workout Activity (navigates from HomeFragment) -->
        <activity
            android:name=".WorkoutActivity"
            android:exported="false"
            android:label="Start Workout"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.FitTrack" />

        <!-- Quick Start Activity (navigates from WorkoutActivity) -->
        <activity
            android:name=".QuickStartActivity"
            android:exported="false"
            android:label="Quick Start Workout"
            android:parentActivityName=".WorkoutActivity"
            android:theme="@style/Theme.FitTrack" />

        <!-- Cardio Workout Activity (navigates from WorkoutActivity) -->
        <activity
            android:name=".CardioWorkoutActivity"
            android:exported="false"
            android:label="Cardio Workout"
            android:parentActivityName=".WorkoutActivity" />

        <!-- Strength Workout Activity (navigates from WorkoutActivity) -->
        <activity
            android:name=".StrengthWorkoutActivity"
            android:exported="false"
            android:label="Strength Training"
            android:parentActivityName=".WorkoutActivity" />

        <!-- Yoga Workout Activity (navigates from WorkoutActivity) -->
        <activity
            android:name=".YogaWorkoutActivity"
            android:exported="false"
            android:label="Yoga Flow"
            android:parentActivityName=".WorkoutActivity" />

        <!-- Empty Activity (Add Goal functionality) -->
        <activity
            android:name=".EmptyActivity"
            android:exported="false"
            android:label="Add New Goal"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.FitTrack" />

        <!-- NEW TIP ACTIVITIES -->
        <!-- Cardio Tips Activity (navigates from TipsFragment) -->
        <activity
            android:name=".CardioTipsActivity"
            android:exported="false"
            android:label="Cardio Tips"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.FitTrack" />

        <!-- Strength Tips Activity (navigates from TipsFragment) -->
        <activity
            android:name=".StrengthTipsActivity"
            android:exported="false"
            android:label="Strength Tips"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.FitTrack" />

        <!-- Nutrition Tips Activity (navigates from TipsFragment) -->
        <activity
            android:name=".NutritionTipsActivity"
            android:exported="false"
            android:label="Nutrition Tips"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.FitTrack" />

    </application>

</manifest>